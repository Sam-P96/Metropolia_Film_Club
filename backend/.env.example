PORT=3000
MONGO_URI=mongodb://localhost:27017/film-club
SECRET=your_jwt_signing_secret
TMDB_TOKEN=your_tmdb_v4_read_access_token

# Password reset emails (Resend). Without RESEND_API_KEY the reset link is
# logged to the server console instead of emailed, which is fine for local dev.
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
# Where the emailed reset link points (the frontend origin).
APP_URL=http://localhost:5173
